# --- Supabase ---
# Postgres connection string (Supabase > Project Settings > Database). Use the pooled
# (transaction) string on serverless hosts such as Vercel.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Dashboard access ---
ADMIN_PASSWORD=change-me
# Optional: separate secret used to sign the session cookie (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# --- Background jobs ---
# Bearer token required by /api/cron/tick (Vercel Cron sends it automatically when set)
CRON_SECRET=change-me-too

# --- Mode ---
# assisted (default): real data; you send each message on Volleybox and confirm it in the app.
# demo: synthetic athletes + fake sends, for trying the app. There is no "live" mode: Volleybox has no public API.
VOLLEYBOX_MODE=assisted

# --- Alerts (optional) ---
# Slack-compatible incoming webhook for "athlete is interested" alerts
ALERT_WEBHOOK_URL=
APP_BASE_URL=http://localhost:3000

# Demo mode only: synthetic pool size per country/year/gender combination
MOCK_POOL_SIZE=8
