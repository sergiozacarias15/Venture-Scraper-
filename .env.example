# --- Supabase ---
# Postgres connection string (Supabase > Project Settings > Database). Use the pooled
# (transaction) string on serverless hosts such as Vercel.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Dashboard access ---
ADMIN_PASSWORD=change-me
# Optional: separate secret used to sign the session cookie (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# --- Background jobs ---
# Bearer token required by /api/cron/tick (Vercel Cron sends it automatically when set)
CRON_SECRET=change-me-too

# --- Volleybox integration (leave unset to use the mock adapters) ---
# Live mode only activates when VOLLEYBOX_MODE=live AND the base URL and key are set.
VOLLEYBOX_MODE=mock
VOLLEYBOX_API_BASE_URL=
VOLLEYBOX_API_KEY=
# Shared secret used to verify HMAC signatures on POST /api/webhooks/volleybox
VOLLEYBOX_WEBHOOK_SECRET=
# Optional: deep link to a conversation, e.g. https://volleybox.net/messages/{thread_id}
VOLLEYBOX_CONVERSATION_URL_TEMPLATE=

# --- Alerts (optional) ---
# Slack-compatible incoming webhook for "athlete is interested" alerts
ALERT_WEBHOOK_URL=
APP_BASE_URL=http://localhost:3000

# Mock discovery pool size per country/year/gender combination
MOCK_POOL_SIZE=8
